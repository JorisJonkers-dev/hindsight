# The api and the worker share the database, the LLM and both TEI models. hindsight-start
# builds the database and TEI URLs from these parts.
HINDSIGHT_DB_HOST=${dependency:platform-postgres.host}
HINDSIGHT_DB_PORT=${dependency:platform-postgres.port}
HINDSIGHT_DB_NAME=hindsight_db
HINDSIGHT_DB_USER=${dependency:platform-postgres.username}
HINDSIGHT_DB_PASSWORD=${dependency:platform-postgres.password}

HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=https://api.mistral.ai/v1
HINDSIGHT_API_LLM_MODEL=mistral-small-2603
HINDSIGHT_API_LLM_API_KEY=${secret:secret/data/platform/hindsight#mistral_api_key}
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2

HINDSIGHT_API_EMBEDDINGS_PROVIDER=tei
HINDSIGHT_EMBEDDINGS_HOST=${dependency:hindsight-embedding.host}
HINDSIGHT_EMBEDDINGS_PORT=${dependency:hindsight-embedding.port}
HINDSIGHT_API_RERANKER_PROVIDER=tei
HINDSIGHT_RERANKER_HOST=${dependency:hindsight-reranker.host}
HINDSIGHT_RERANKER_PORT=${dependency:hindsight-reranker.port}
HINDSIGHT_API_RERANKER_TEI_HTTP_TIMEOUT=10
HINDSIGHT_API_RERANKER_MAX_CANDIDATES=20
HINDSIGHT_API_RERANKER_1_PROVIDER=rrf
