MODEL_ID=BAAI/bge-m3
# Kubernetes sets HOSTNAME to the pod name, which TEI would bind to alone.
HOSTNAME=0.0.0.0
PORT=8091
AUTO_TRUNCATE=true
# TEI sizes its tokenizers and its warmup batch to the node, not the pod: bound both.
TOKENIZATION_WORKERS=2
MAX_BATCH_TOKENS=2048
MAX_CLIENT_BATCH_SIZE=256
PAYLOAD_LIMIT=10000000
